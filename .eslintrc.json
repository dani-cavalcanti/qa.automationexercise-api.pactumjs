{
  "root": true,
  "env": {
    "node": true,
    "mocha": true,
    "es2022": true
  },
  "extends": ["eslint:recommended", "plugin:mocha/recommended", "prettier"],
  "plugins": ["mocha"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "rules": {
    "mocha/no-mocha-arrows": "off",
    "mocha/no-setup-in-describe": "off",
    "mocha/no-hooks-for-single-case": "off"
  }
}
